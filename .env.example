# Copy to .env (or export these in your shell) to override application.yml's local-dev
# defaults. None of these are required to run locally against docker-compose.yml's
# Postgres container — application.yml already defaults to the values below.

# --- Database (matches docker-compose.yml's postgres service) ---
DATABASE_URL=jdbc:postgresql://localhost:5435/elderhive
DATABASE_USER=elderhive
DATABASE_PASSWORD=elderhive

# --- JWT ---
# Generate a real random secret for anything beyond local dev, e.g.:
#   openssl rand -base64 64
JWT_SECRET=dev-only-insecure-secret-change-me-before-any-real-deployment

# --- CORS ---
# Origin allowed to call this API - Vite's default dev server port.
APP_FRONTEND_URL=http://localhost:5173
