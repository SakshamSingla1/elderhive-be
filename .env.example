# Copy to .env (or export these in your shell) to override application.yml's local-dev
# defaults. Every variable below is read by application.yml - this file is just a
# convenience mirror documenting what exists and what each one is for; see that file for
# the authoritative default values.
#
# Nothing in this file is required to run locally against docker-compose.yml's Postgres
# container - every value below already has a safe local-dev default, and every optional
# integration (mail, Cloudinary, Stripe, web push) degrades gracefully to a no-op/simulated
# behavior when left blank. A REAL deployment should treat the "REQUIRED FOR PRODUCTION"
# section as mandatory.

# ============================================================
# REQUIRED FOR PRODUCTION (safe dev defaults below; MUST override before a real deploy)
# ============================================================

# --- Database (matches docker-compose.yml's postgres service for local dev) ---
DATABASE_URL=jdbc:postgresql://localhost:5435/elderhive
DATABASE_USER=elderhive
DATABASE_PASSWORD=elderhive

# --- JWT ---
# Generate a real random secret for anything beyond local dev, e.g.:
#   openssl rand -base64 64
JWT_SECRET=dev-only-insecure-secret-change-me-before-any-real-deployment

# --- CORS ---
# Origin allowed to call this API - Vite's default dev server port locally; the deployed
# frontend's real origin in production.
APP_FRONTEND_URL=http://localhost:5173

# This server's own public URL - used to build absolute links (e.g. local-disk file URLs
# when Cloudinary isn't configured).
APP_URL=http://localhost:8080

# MUST be "true" in any real deployment (served over HTTPS) - a Secure cookie is never
# sent back by the browser over plain HTTP, so leaving this false in production would
# silently break login. Stays false only for local dev (plain http://localhost).
COOKIE_SECURE=false

# ============================================================
# OPTIONAL - every one of these degrades gracefully to a documented fallback when unset
# ============================================================

# --- Server ---
SERVER_PORT=8080
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# --- Admin bootstrap ---
# The email of an existing ADMIN account to grant the "Super Admin" role to on next boot -
# the only way to create the first fine-grained admin (AdminBootstrapSeeder). Blank -> no-op.
# Safe to leave set permanently; never reassigns a role once one already exists.
ADMIN_BOOTSTRAP_EMAIL=

# --- SMTP email (Prompt 101 — see note below if that phase hasn't landed yet) ---
# Blank username/password -> NotificationServiceImpl's email channel logs a simulated send
# instead of actually emailing anyone - safe for local dev/CI.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@elderhive.app

# --- Password reset ---
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# --- Web Push (VAPID) ---
# Blank -> VapidKeyProvider generates an ephemeral key pair every boot (fine for local dev,
# but subscriptions don't survive a restart). Generate a persistent pair once for any real
# deployment, e.g. via the `web-push` npm package's `web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@elderhive.app

# --- File storage (Cloudinary) ---
# Blank -> uploads fall back to local disk (FILE_UPLOAD_DIR below), served from this
# server's own /uploads/** path - fine for local dev, NOT durable across redeploys on most
# hosts (including Render's ephemeral filesystem). Set all three for a real deployment.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FILE_UPLOAD_DIR=uploads
FILE_PUBLIC_BASE_URL=

# --- Geocoding (Nominatim) ---
# Nominatim's usage policy requires a real contact identifier in every request's
# User-Agent. The default works, but a real deployment should set a real support address.
GEOCODING_CONTACT_EMAIL=support@elderhive.app

# --- Payments (Stripe) ---
# Blank -> every payment endpoint fails fast with PAYMENT_GATEWAY_NOT_CONFIGURED; payments
# are additive (Prompt 97), so the rest of the app works fully without these ever being
# set. Get test keys at https://dashboard.stripe.com/test/apikeys. The webhook secret
# comes from the Stripe CLI (`stripe listen`) for local dev or the dashboard's webhook
# endpoint config for a real deployment.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- JWT token lifetimes ---
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
